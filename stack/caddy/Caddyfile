{
	auto_https off
	admin off
}

# Portail : la page d'accueil qui regroupe toutes les applications.
#
# /status/<app> renvoie la page d'accueil de l'app (via le proxy lui-même) :
# le portail lit ainsi le vrai code HTTP sans problème de CORS (502 = app arrêtée).
(status) {
	handle /status/{args[0]} {
		rewrite * {args[2]}
		reverse_proxy {args[1]}:8000 {
			header_up Host {upstream_hostport}
		}
	}
}

http://startkit.{$DOMAIN:localhost}:8000 {
	import status docs docs.localhost /
	import status visio visio.localhost /
	import status messages messages.localhost /
	import status projects projects.localhost /
	import status fichiers fichiers.localhost /
	import status grist grist.localhost /status
	import status transfers transfers.localhost /
	import status assistant assistant.localhost /
	import status auth auth.localhost /realms/startkit
	import status mail mail.localhost /
	import status s3-console s3-console.localhost /

	handle {
		root * /srv/portal
		file_server
	}
}

http://localhost:8000 {
	redir http://startkit.localhost:8000{uri}
}

# Keycloak partagé : connexion unique pour toutes les applications.
http://auth.{$DOMAIN:localhost}:8000 {
	reverse_proxy keycloak:8080
}

# Boîte de réception de développement : tous les e-mails envoyés par les apps.
http://mail.{$DOMAIN:localhost}:8000 {
	reverse_proxy mail:8025
}

# Stockage S3 (API) et sa console d'administration.
http://s3.{$DOMAIN:localhost}:8000 {
	reverse_proxy s3:9000
}

http://s3-console.{$DOMAIN:localhost}:8000 {
	reverse_proxy s3:9001
}

# Une entrée par application, dans stack/caddy/apps/<app>.caddy
import /etc/caddy/apps/*.caddy
