# La Suite Drive (« Fichiers ») — routeur nginx du conteneur drive-frontend (port 8083).
#
# Assemblé d'après le dépôt drive (v0.26.0) :
#   - docker/files/production/etc/nginx/conf.d/default.conf (routes backend/frontend,
#     /media/ et /media-auth) ;
#   - docker/files/development/etc/nginx/conf.d/default.conf (/media/preview/) ;
#   - les ingress media/media-preview du chart helm (en-têtes de sécurité).
# Caddy ne fait que lui passer http://fichiers.localhost:8000
# (stack/caddy/apps/drive.caddy).
#
# Les ${VAR} sont remplacées au démarrage par l'entrypoint de l'image nginx
# (envsubst des fichiers de /etc/nginx/templates) ; les $variables nginx en
# minuscules ne sont pas touchées. Variables : environment de drive-frontend.
#
# Écarts avec l'original, tous dus au HTTP local :
#   - écoute en HTTP simple, sans certificat ;
#   - S3 en http://s3:9000 (au lieu de minio:9000) ;
#   - X-Forwarded-Proto vaut $scheme (http) au lieu de "https" en dur ;
#   - les upstreams sont résolus en continu par le DNS de Docker (resolver +
#     "resolve") : recréer drive-backend ne laisse pas une IP périmée dans nginx,
#     et nginx démarre même si un service n'est pas encore là.

resolver 127.0.0.11 valid=10s ipv6=off;

upstream drive_backend {
    zone drive_backend 64k;
    server ${BACKEND_HOST}:8000 resolve fail_timeout=0;
}

upstream drive_frontend {
    server ${FRONTEND_HOST}:8080 fail_timeout=0;
}

upstream drive_s3 {
    zone drive_s3 64k;
    server ${S3_HOST} resolve;
}

server {
    listen 8083;
    server_name localhost;
    charset utf-8;

    # Les fichiers vont directement du navigateur à S3 (URL présignée) ; seuls
    # transitent ici les appels d'API (même valeur que l'exemple helm).
    client_max_body_size 150m;

    # Disables server version feedback on pages and in headers
    server_tokens off;

    location @proxy_to_drive_backend {
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Export ZIP d'un dossier : réponse en flux, aussi longue que gunicorn (90 s).
        proxy_read_timeout 90s;

        proxy_redirect off;
        proxy_pass http://drive_backend;
    }

    location @proxy_to_drive_frontend {
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_redirect off;
        proxy_pass http://drive_frontend;
    }

    location / {
        try_files $uri @proxy_to_drive_frontend;
    }

    location /api {
        try_files $uri @proxy_to_drive_backend;
    }

    location /admin {
        try_files $uri @proxy_to_drive_backend;
    }

    location /external_api {
        try_files $uri @proxy_to_drive_backend;
    }

    location /static {
        try_files $uri @proxy_to_drive_backend;
    }

    # Fichiers : téléchargement (toujours en pièce jointe).
    location /media/ {
        # Auth request configuration
        auth_request /media-auth;
        auth_request_set $authHeader $upstream_http_authorization;
        auth_request_set $authDate $upstream_http_x_amz_date;
        auth_request_set $authContentSha256 $upstream_http_x_amz_content_sha256;

        # Pass specific headers from the auth response
        proxy_set_header Authorization $authHeader;
        proxy_set_header X-Amz-Date $authDate;
        proxy_set_header X-Amz-Content-SHA256 $authContentSha256;

        # Get resource from the S3 server (signature computed by the backend
        # for the host of AWS_S3_ENDPOINT_URL, hence the Host header)
        proxy_pass http://drive_s3/${BUCKET_NAME}/;
        proxy_set_header Host ${S3_HOST};

        add_header Content-Security-Policy "default-src 'none'" always;
        add_header Content-Disposition "attachment";
        add_header X-Robots-Tag noindex always;
    }

    # Fichiers : aperçu dans l'interface (images, PDF, vidéos…), sans pièce jointe.
    # Le backend refuse les types non prévisualisables (ITEM_PREVIEWABLE_MIME_TYPES).
    location /media/preview/ {
        auth_request /media-auth;
        auth_request_set $authHeader $upstream_http_authorization;
        auth_request_set $authDate $upstream_http_x_amz_date;
        auth_request_set $authContentSha256 $upstream_http_x_amz_content_sha256;

        proxy_set_header Authorization $authHeader;
        proxy_set_header X-Amz-Date $authDate;
        proxy_set_header X-Amz-Content-SHA256 $authContentSha256;

        proxy_pass http://drive_s3/${BUCKET_NAME}/;
        proxy_set_header Host ${S3_HOST};

        add_header Content-Security-Policy "default-src 'none'" always;
        add_header X-Robots-Tag noindex always;
    }

    location /media-auth {
        proxy_pass http://drive_backend/api/v1.0/items/media-auth/;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Original-URL $request_uri;

        # Prevent the body from being passed
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-Method $request_method;
    }
}
