# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# La Suite Meet (Visio) — variables d'environnement du backend (meet-backend, meet-migrate).
# Basé sur env.d/production.dist/common et env.d/development/common du dépôt meet.
# Tout fonctionne en HTTP simple sur http://visio.localhost:8000 (valeurs de dev, non secrètes).

# --- Django -------------------------------------------------------------------
# La classe "Production" de meet force HTTPS (SECURE_SSL_REDIRECT, cookies Secure, HSTS)
# sans variable pour le désactiver, et "Development" exige des paquets absents de l'image.
# On utilise donc la classe "Http" (= Production sans HTTPS), définie dans meet.yml
# (configs: meet-settings-http, montée dans /app/meet/settings_http.py).
DJANGO_SETTINGS_MODULE=meet.settings_http
DJANGO_CONFIGURATION=Http
DJANGO_SECRET_KEY=CHANGEME
# visio.localhost : navigateur (via Caddy) ; meet-backend : webhooks LiveKit ; localhost : healthcheck
DJANGO_ALLOWED_HOSTS=visio.localhost,meet-backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://visio.localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://visio.localhost:8000
# Avertissements de sécurité attendus en HTTP local (HSTS, SSL redirect, cookies Secure)
DJANGO_SILENCED_SYSTEM_CHECKS=security.W004,security.W008,security.W012,security.W016
PYTHONPATH=/app

# --- Base de données / cache ----------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=meet
DB_USER=meet
DB_PASSWORD=CHANGEME
# Redis partagé : base 2 pour Meet (cache + sessions), base 3 pour LiveKit (livekit.yaml)
REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_ENABLED=False

# --- Statiques (servis par whitenoise via /static) ------------------------------
STORAGES_STATICFILES_BACKEND=whitenoise.storage.CompressedManifestStaticFilesStorage

# --- Stockage S3 (MinIO partagé) — utilisé uniquement par l'enregistrement -------
AWS_S3_ENDPOINT_URL=http://s3:9000
AWS_S3_ACCESS_KEY_ID=startkit
AWS_S3_SECRET_ACCESS_KEY=CHANGEME
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=meet-recordings
# Upload de fonds d'écran (envoi direct navigateur -> S3 + proxy /media authentifié) : désactivé
FILE_UPLOAD_ENABLED=False

# --- URLs publiques -------------------------------------------------------------
APPLICATION_BASE_URL=http://visio.localhost:8000

# --- E-mail (mailpit, lisible sur http://mail.localhost:8000) --------------------
DJANGO_EMAIL_HOST=mail
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_FROM=visio@startkit.localhost
DJANGO_EMAIL_BRAND_NAME=StartKit
DJANGO_EMAIL_SUPPORT_EMAIL=support@startkit.localhost
DJANGO_EMAIL_LOGO_IMG=http://visio.localhost:8000/assets/logo-suite-numerique.png
DJANGO_EMAIL_DOMAIN=visio.localhost:8000
DJANGO_EMAIL_APP_BASE_URL=http://visio.localhost:8000

# --- OIDC (Keycloak partagé, realm startkit, client meet) -------------------------
# Les conteneurs joignent auth.localhost:8000 via l'alias réseau de Caddy : mêmes URL partout.
OIDC_OP_JWKS_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=CHANGEME
OIDC_OP_USER_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/logout
OIDC_OP_URL=http://auth.localhost:8000/realms/startkit
OIDC_RP_CLIENT_ID=meet
OIDC_RP_CLIENT_SECRET=CHANGEME
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
OIDC_USERINFO_SHORTNAME_FIELD=given_name
OIDC_REDIRECT_ALLOWED_HOSTS=visio.localhost:8000
OIDC_REDIRECT_REQUIRE_HTTPS=False
LOGIN_REDIRECT_URL=http://visio.localhost:8000
LOGIN_REDIRECT_URL_FAILURE=http://visio.localhost:8000
LOGOUT_REDIRECT_URL=http://visio.localhost:8000

# --- LiveKit --------------------------------------------------------------------
# Même URL pour le navigateur (ws://livekit.localhost:8000) et le backend (alias Caddy).
# Clé/secret identiques à stack/meet/livekit.yaml (keys: meet: ...).
LIVEKIT_API_KEY=CHANGEME
LIVEKIT_API_SECRET=CHANGEME
LIVEKIT_API_URL=http://livekit.localhost:8000
LIVEKIT_VERIFY_SSL=False
LIVEKIT_FORCE_WSS_PROTOCOL=False
ALLOW_UNREGISTERED_ROOMS=False

# --- Fonctionnalités lourdes désactivées (pas d'egress / summary / agents) -------
# Pour l'enregistrement : `docker compose --profile recording up -d` puis passer
# RECORDING_ENABLE=True (voir les commentaires de stack/apps/meet.yml et meet.caddy).
RECORDING_ENABLE=False
RECORDING_DOWNLOAD_BASE_URL=http://visio.localhost:8000/recording
ROOM_SUBTITLE_ENABLED=False
METADATA_COLLECTOR_ENABLED=False
ROOM_TELEPHONY_ENABLED=False
EXTERNAL_API_ENABLED=False
ADDONS_ENABLED=False
CONNECTION_TEST_ENABLED=False

# --- Interface ------------------------------------------------------------------
FRONTEND_USE_FRENCH_GOV_FOOTER=False
FRONTEND_USE_PROCONNECT_BUTTON=False
FRONTEND_SILENCE_LIVEKIT_DEBUG=True
