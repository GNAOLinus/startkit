# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# La Suite Transfers — variables partagées par transfers-migrate, transfers-backend
# et transfers-worker. D'après src/backend/transfers/settings.py, README.md et
# env.d/development/backend.defaults du dépôt transfers (v0.5.2).
# Adresse publique : http://transfers.localhost:8000 (même URL depuis les conteneurs,
# grâce aux alias réseau du proxy Caddy).
# Secrets de développement uniquement : ne pas réutiliser ailleurs.

## Django
# Classe "Http" (config transfers-settings-http dans stack/apps/transfers.yml) :
# Production sans redirection HTTPS, sans HSTS ni cookies Secure.
DJANGO_SETTINGS_MODULE=transfers.settings_http
DJANGO_CONFIGURATION=Http
DJANGO_SECRET_KEY=CHANGEME
# transfers-backend : appels directs sur le réseau compose ; localhost : healthcheck.
DJANGO_ALLOWED_HOSTS=transfers.localhost,transfers-backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://transfers.localhost:8000

LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

## Base de données (postgres partagé, base "transfers")
DB_HOST=postgres
DB_PORT=5432
DB_NAME=transfers
DB_USER=transfers
DB_PASSWORD=CHANGEME

## Redis partagé
# Base 9 : cache Django + sessions (SESSION_ENGINE=cache) + compteurs de throttling.
REDIS_URL=redis://redis:6379/9
# Base 10 : broker Dramatiq (Redis Streams) + verrou de l'ordonnanceur périodique.
# Redis doit rester en noeviction (défaut de l'image redis:7-alpine).
WORKER_BROKER_URL=redis://redis:6379/10

## E-mails (mailpit : http://mail.localhost:8000)
# Les liens des e-mails sont construits à partir de LOGIN_REDIRECT_URL.
DJANGO_EMAIL_HOST=mail
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_FROM=transfers@startkit.localhost
# Logo d'en-tête vide => logo Transfers servi par le frontend
# (http://transfers.localhost:8000/images/transfers-logo.png). Pas de logo de pied.
DJANGO_EMAIL_LOGO_IMG=
DJANGO_EMAIL_FOOTER_LOGOS=[]

## Stockage S3 (silo/MinIO partagé, bucket transfers-storage créé par s3-init)
# Le backend parle à s3:9000. Les URL présignées (PUT des parts à l'envoi, GET au
# téléchargement) sont signées pour l'hôte que joint le navigateur
# (s3.localhost:8000, Caddy conserve l'en-tête Host). Adressage « path-style ».
AWS_S3_ENDPOINT_URL=http://s3:9000
AWS_S3_DOMAIN_REPLACE=http://s3.localhost:8000
AWS_S3_ACCESS_KEY_ID=startkit
AWS_S3_SECRET_ACCESS_KEY=CHANGEME
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=transfers-storage

## Transferts (valeurs par défaut du projet, explicitées)
# 20 Gio par fichier et par transfert, 20 fichiers max, expiration 1/7/30 jours.
# À baisser si le disque est juste (S3 stocke tout dans le volume s3-data).
TRANSFER_MAX_FILE_SIZE=21474836480
TRANSFER_MAX_TOTAL_SIZE=21474836480
TRANSFER_MAX_FILES_PER_TRANSFER=20
TRANSFER_EXPIRY_CHOICES=1,7,30
TRANSFER_DEFAULT_EXPIRY_DAYS=1
# Délai de grâce (heures) entre la fermeture d'un lien et l'effacement S3.
TRANSFER_PURGE_DELAY_HOURS=6
# Chiffrement côté navigateur : toujours actif. « Confidentiel » (clé jamais
# transmise au serveur, dans le #fragment du lien) proposé dans le formulaire.
TRANSFER_CONFIDENTIAL_ENABLED=True

## OIDC (Keycloak partagé, realm "startkit", client "transfers")
# Les conteneurs joignent auth.localhost:8000 via l'alias réseau du proxy.
OIDC_OP_JWKS_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=CHANGEME
OIDC_OP_USER_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=transfers
OIDC_RP_CLIENT_SECRET=CHANGEME
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"
# Liste à virgules, pas du JSON (ListValue de django-configurations).
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
# Défaut du projet : False (comptes provisionnés à part). Ici, tout compte Keycloak
# du realm obtient un compte Transfers à sa première connexion.
OIDC_CREATE_USER=True
OIDC_REDIRECT_ALLOWED_HOSTS=transfers.localhost:8000
OIDC_REDIRECT_REQUIRE_HTTPS=false
OIDC_STORE_CLAIMS=

LOGIN_REDIRECT_URL=http://transfers.localhost:8000
LOGIN_REDIRECT_URL_FAILURE=http://transfers.localhost:8000/errors
LOGOUT_REDIRECT_URL=http://transfers.localhost:8000

## Fonctions désactivées
# Antivirus (file-scanner + ClamAV) : désactivé, les fichiers sont marqués
# « skipped » (de toute façon chiffrés, donc illisibles par ClamAV).
SCAN_ENABLED=False
# Sélecteur « Joindre depuis Fichiers (Drive) » : masqué tant que vide. L'activer
# demande aussi CORS_ALLOWED_ORIGINS / SDK_CORS_ALLOWED_ORIGINS côté Drive et
# DRIVE_IMPORT_ALLOW_PRIVATE_NETWORKS=True ici.
DRIVE_BASE_URL=
# LaGaufre (sélecteur d'apps La Suite) : masqué tant que vide.
LAGAUFRE_WIDGET_URL=
LAGAUFRE_API_URL=
# Pas de Sentry (SENTRY_DSN absent), pas d'URL d'aide / CGU / support.
HELP_URL=
SUPPORT_URL=
TERMS_URL=
