# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# Grist (grist-core) dans StartKit — http://grist.localhost:8000

APP_HOME_URL=http://grist.localhost:8000
GRIST_SESSION_SECRET=CHANGEME
# Un seul site d'équipe, ouvert à tous les comptes Keycloak ; user1 en est le propriétaire.
GRIST_SINGLE_ORG=docs
GRIST_ORG_IN_PATH=false
GRIST_DEFAULT_EMAIL=user1@startkit.localhost
# Administrateur de l’instance (sans lui, Grist renvoie tout le monde vers /boot).
GRIST_ADMIN_EMAIL=user1@startkit.localhost
# Installation neuve déjà configurée par l’environnement : pas d’étape /boot.
GRIST_IN_SERVICE=true
GRIST_FORCE_LOGIN=true
GRIST_ANON_PLAYGROUND=false
GRIST_TELEMETRY_LEVEL=off
GRIST_DEFAULT_LOCALE=fr
GRIST_WIDGET_LIST_URL=https://github.com/gristlabs/grist-widget/releases/download/latest/manifest.json

# --- OIDC (Keycloak partagé, royaume startkit, client grist) ---------------
GRIST_OIDC_SP_HOST=http://grist.localhost:8000
GRIST_OIDC_IDP_ISSUER=http://auth.localhost:8000/realms/startkit
GRIST_OIDC_IDP_CLIENT_ID=grist
GRIST_OIDC_IDP_CLIENT_SECRET=CHANGEME
GRIST_OIDC_IDP_SCOPES=openid email profile

# --- Base « home » dans le PostgreSQL partagé -------------------------------
TYPEORM_TYPE=postgres
TYPEORM_HOST=postgres
TYPEORM_PORT=5432
TYPEORM_DATABASE=grist
TYPEORM_USERNAME=grist
TYPEORM_PASSWORD=CHANGEME

# --- Redis partagé (sessions et notifications), base 8 ----------------------
REDIS_URL=redis://redis:6379/8
