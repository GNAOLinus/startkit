# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# La Suite Conversations (« Assistant ») — conversations-backend, -worker, -migrate.
# D'après docs/env.md, env.d/development/common.dist et le chart helm du dépôt
# suitenumerique/conversations (v0.0.28).
# Adresse publique : http://assistant.localhost:8000 (même URL depuis les conteneurs,
# grâce aux alias réseau du proxy Caddy).
# Secrets de développement uniquement : ne pas réutiliser ailleurs.

## Django
# Classe "Http" (config conversations-settings-http dans stack/apps/ia.yml) :
# Production sans redirection HTTPS, sans HSTS ni cookies Secure.
DJANGO_SETTINGS_MODULE=conversations.settings_http
DJANGO_CONFIGURATION=Http
DJANGO_SECRET_KEY=CHANGEME
# conversations-backend : appels directs sur le réseau compose ; localhost : sonde.
DJANGO_ALLOWED_HOSTS=assistant.localhost,conversations-backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://assistant.localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://assistant.localhost:8000
DJANGO_LANGUAGE_CODE=fr-fr
PYTHONPATH=/app
# Processus uvicorn (ASGI, asynchrone) : 1 suffit en local (l'image en lance 4).
WEB_CONCURRENCY=1

# Super-utilisateur Django (/admin, identifiant = e-mail), créé par conversations-migrate.
DJANGO_SUPERUSER_EMAIL=admin@startkit.localhost
DJANGO_SUPERUSER_PASSWORD=CHANGEME

## Logging
LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

## Base de données (postgres partagé, base "conversations")
# Extensions créées par la 1re migration : pg_trgm, unaccent, fuzzystrmatch
# (contrib, « trusted » : le propriétaire de la base suffit). Pas de pgvector.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=conversations
DB_USER=conversations
DB_PASSWORD=CHANGEME

## Redis partagé : base 11 pour le cache et les sessions, base 12 pour Celery
## (file de tâches + résultats).
REDIS_URL=redis://redis:6379/11
CELERY_BROKER_URL=redis://redis:6379/12
CELERY_RESULT_BACKEND=redis://redis:6379/12

## E-mails (mailpit : http://mail.localhost:8000)
DJANGO_EMAIL_HOST=mail
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_FROM=assistant@startkit.localhost
DJANGO_EMAIL_BRAND_NAME="La Suite Numérique"
DJANGO_EMAIL_LOGO_IMG=http://assistant.localhost:8000/assets/logo-suite-numerique.png

## Fichiers (S3 partagé, bucket conversations-storage, créé par s3-init)
# Inutilisé tant que l'envoi de documents et les images sont désactivés, mais le
# stockage par défaut de Django est S3 : on le renseigne quand même.
# Envois : PUT direct du navigateur sur une URL présignée pour s3.localhost:8000
# (AWS_S3_DOMAIN_REPLACE) ; lectures via /media/ (autorisation du backend).
AWS_S3_ENDPOINT_URL=http://s3:9000
AWS_S3_DOMAIN_REPLACE=http://s3.localhost:8000
AWS_S3_ACCESS_KEY_ID=startkit
AWS_S3_SECRET_ACCESS_KEY=CHANGEME
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=conversations-storage
MEDIA_BASE_URL=http://assistant.localhost:8000

## OIDC (Keycloak partagé, realm "startkit", client "conversations")
OIDC_OP_JWKS_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=CHANGEME
OIDC_OP_USER_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=conversations
OIDC_RP_CLIENT_SECRET=CHANGEME
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"
# Claims standard de Keycloak (les valeurs par défaut first_name/last_name n'y sont pas).
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
OIDC_USERINFO_SHORTNAME_FIELD=given_name
OIDC_REDIRECT_ALLOWED_HOSTS=assistant.localhost:8000
# Production l'impose à true par défaut : on sert en HTTP.
OIDC_REDIRECT_REQUIRE_HTTPS=false

LOGIN_REDIRECT_URL=http://assistant.localhost:8000
LOGIN_REDIRECT_URL_FAILURE=http://assistant.localhost:8000
LOGOUT_REDIRECT_URL=http://assistant.localhost:8000

# Connexion silencieuse (prompt=none) : déjà connecté à Keycloak via une autre
# app de la suite => connecté à l'Assistant sans clic.
FRONTEND_SILENT_LOGIN_ENABLED=true

## LLM : Ollama local (API compatible OpenAI), via ollama-relay
# Les modèles sont décrits dans stack/conversations/llm-configuration.json, qui lit
# l'URL et la clé ci-dessous (préfixe "environ."). Ollama n'exige pas de clé :
# une valeur non vide suffit.
LLM_CONFIGURATION_FILE_PATH=/startkit/llm-configuration.json
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=CHANGEME
LLM_DEFAULT_MODEL_HRID=qwen2.5-1.5b
LLM_SUMMARIZATION_MODEL_HRID=qwen2.5-1.5b-resume
# Pas de bascule automatique : elle ne s'appuie que sur la santé publiée par Albert.
# LLM_FALLBACK_MODEL_HRID_1=

# Petite fenêtre de contexte (Ollama sert 4096 jetons par défaut, voir
# max_token_context dans llm-configuration.json). Sans documents joints, on donne
# 80 % du contexte à l'historique : 4096 x 0,8 - 1200 = ~2 000 jetons d'historique
# avant résumé, le reste pour les consignes, l'outil interne et la réponse.
DEFAULT_MAX_TOKEN_CONTEXT=CHANGEME
DOCUMENT_CONTEXT_BUDGET_RATIO=0.2
DOCUMENT_CONTEXT_SECURITY_BUFFER_TOKENS=CHANGEME
# Résumé de l'historique (tâche Celery limitée à 120 s ; ~10 jetons/s sur CPU).
CONVERSATION_SUMMARY_MAX_TOKENS=CHANGEME
CONVERSATION_SUMMARY_CONTEXT_MESSAGES=4
# Plafond de sortie global (le max_tokens de chaque modèle l'emporte).
LLM_MAX_OUTPUT_TOKENS_PER_MESSAGE=CHANGEME

# Limites de création de conversations : plus larges qu'en production pour tester.
API_CONVERSATION_CREATE_HOURLY_THROTTLE_RATE=200/hour
API_CONVERSATION_CREATE_DAILY_THROTTLE_RATE=1000/day

## Fonctions désactivées (aucun service externe)
# Valeurs : DISABLED, DYNAMIC (Posthog) ou ENABLED.
FEATURE_FLAG_WEB_SEARCH=DISABLED
# Envoi de documents : le RAG par défaut passe par l'API Albert (parsing, vecteurs).
FEATURE_FLAG_DOCUMENT_UPLOAD=DISABLED
FEATURE_FLAG_PRESENTATION_GENERATION=DISABLED
FEATURE_FLAG_DATAGOUV_CONNECTOR=DISABLED
# Connecteur data.gouv (MCP) : inerte tant que l'URL est vide.
DATAGOUV_CONNECTOR_URL=
# Tâches planifiées Albert (santé des modèles, désindexation) : désactivées.
MODEL_HEALTH_POLL_PROVIDER=
DEINDEX_INACTIVE_COLLECTIONS_CRON=
# « Éditer dans Docs » : désactivé (DOCS_BASE_URL absent). Il faudrait que Docs
# soit configuré en serveur de ressources OIDC et que DOCS_BASE_URL soit en HTTPS
# (ou exactement localhost), ce qui n'est pas le cas de docs.localhost:8000.
# DOCS_BASE_URL=
OIDC_STORE_ACCESS_TOKEN=CHANGEME
OIDC_STORE_REFRESH_TOKEN=CHANGEME
# Analytics et suivi : POSTHOG_KEY, SENTRY_DSN, LANGFUSE_*, BREVO_API_KEY absents.
LANGFUSE_ENABLED=false
PROMETHEUS_METRICS_ENABLED=false
