# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# La Suite Docs — backend Django (docs-backend, docs-celery, docs-migrate).
# D'après env.d/production.dist/{backend,common,postgresql,yprovider} du dépôt docs (v6.0.4).
# Adresse publique : http://docs.localhost:8000 (même URL depuis les conteneurs,
# grâce aux alias réseau du proxy Caddy).
# Secrets de développement uniquement : ne pas réutiliser ailleurs.

## Django
# Classe "Http" (config docs-settings-http dans stack/apps/docs.yml) : Production
# sans redirection HTTPS, sans HSTS ni cookies Secure, que Production force en dur.
DJANGO_SETTINGS_MODULE=impress.settings_http
DJANGO_CONFIGURATION=Http
DJANGO_SECRET_KEY=CHANGEME
# docs-backend : appels directs de docs-yhub et docs-y-provider ; localhost : sonde.
DJANGO_ALLOWED_HOSTS=docs.localhost,docs-backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://docs.localhost:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://docs.localhost:8000
PYTHONPATH=/app
# uvicorn (commande par défaut de l'image) : 2 workers au lieu de 4.
WEB_CONCURRENCY=2

# Super-utilisateur Django (/admin), créé par docs-migrate.
DJANGO_SUPERUSER_EMAIL=admin@startkit.localhost
DJANGO_SUPERUSER_PASSWORD=CHANGEME

## Logging
LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

## Base de données (postgres partagé, base "docs")
DB_HOST=postgres
DB_PORT=5432
DB_NAME=docs
DB_USER=docs
DB_PASSWORD=CHANGEME

## Redis partagé, base 0 : cache, sessions et file Celery.
# (La base 1 est celle du serveur de collaboration, stack/env/docs-yhub.env.)
REDIS_URL=redis://redis:6379/0
DJANGO_CELERY_BROKER_URL=redis://redis:6379/0

## JWT
# Signe les jetons que le backend présente à docs-yhub et docs-y-provider, qui
# les vérifient avec la clé publique de /api/v1.0/jwks. Clé générée par docs-keys.
JWT_PRIVATE_KEY_FILE=CHANGEME

## Serveur de collaboration (yhub), joint en direct sur le réseau compose.
YHUB_API_BASE_URL=http://docs-yhub:3002
COLLABORATION_API_URL=http://docs-yhub:3002/collaboration
# Ce que le navigateur ouvre (routé par docs-frontend vers docs-yhub).
COLLABORATION_WS_URL=ws://docs.localhost:8000/collaboration/ws/v1/docs

## Service de conversion (y-provider)
Y_PROVIDER_API_BASE_URL=http://docs-y-provider:4444/api/
# Même valeur dans docs-yhub.env et docs-y-provider.env : en-tête X-Y-Provider-Key
# qui exempte les appels du serveur de collaboration du throttling de l'API.
Y_PROVIDER_API_KEY=CHANGEME

## E-mails (mailpit : http://mail.localhost:8000)
DJANGO_EMAIL_HOST=mail
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_FROM=docs@startkit.localhost
DJANGO_EMAIL_BRAND_NAME="La Suite Numérique"
DJANGO_EMAIL_LOGO_IMG=http://docs.localhost:8000/assets/logo-suite-numerique.png
DJANGO_EMAIL_URL_APP=http://docs.localhost:8000

## Médias (S3 partagé ; servis sur /media/ via l'auth_request de docs-frontend)
AWS_S3_ENDPOINT_URL=http://s3:9000
AWS_S3_ACCESS_KEY_ID=startkit
AWS_S3_SECRET_ACCESS_KEY=CHANGEME
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=docs-media-storage
MEDIA_BASE_URL=http://docs.localhost:8000

## OIDC (Keycloak partagé, realm "startkit", client "docs")
OIDC_OP_JWKS_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=CHANGEME
OIDC_OP_USER_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=docs
OIDC_RP_CLIENT_SECRET=CHANGEME
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"
# Claims standard de Keycloak (les valeurs par défaut first_name/last_name n'y sont pas).
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
OIDC_USERINFO_SHORTNAME_FIELD=given_name
OIDC_REDIRECT_ALLOWED_HOSTS=docs.localhost:8000
OIDC_REDIRECT_REQUIRE_HTTPS=false

LOGIN_REDIRECT_URL=http://docs.localhost:8000
LOGIN_REDIRECT_URL_FAILURE=http://docs.localhost:8000
LOGOUT_REDIRECT_URL=http://docs.localhost:8000

# Connexion silencieuse (prompt=none) : déjà connecté à Keycloak via une autre
# app de la suite => connecté à Docs sans clic.
FRONTEND_SILENT_LOGIN_ENABLED=true

## IA locale : modèle servi par Ollama sur cette machine (rien ne sort).
# Actions IA du menu de l'éditeur (résumer, corriger, reformuler, traduire…),
# exécutées par le backend Docs vers l'API compatible OpenAI d'Ollama.
AI_FEATURE_ENABLED=true
AI_FEATURE_LEGACY_ENABLED=true
# Assistant BlockNote (modules « XL », sous licence GPL) : laissé désactivé.
AI_FEATURE_BLOCKNOTE_ENABLED=false
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=CHANGEME
# qwen2.5:1.5b tient en RAM avec toute la stack ; mistral:latest est meilleur
# mais demande 4,5 Go libres.
AI_MODEL=qwen2.5:1.5b
AI_BOT={"name": "Assistant StartKit", "color": "#4f5bff"}
AI_ALLOW_REACH_FROM=authenticated
