# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# La Suite Messages — variables partagées par messages-migrate, messages-backend,
# messages-worker et messages-mta-in. Référence : docs/env.md du dépôt messages (v0.10.0).
# Valeurs de développement uniquement : ne pas réutiliser en production.

# --- Django ---------------------------------------------------------------
# Configuration « Http » = Production sans HTTPS (définie dans stack/apps/messages.yml).
DJANGO_SETTINGS_MODULE=messages.settings_http
DJANGO_CONFIGURATION=Http
DJANGO_SECRET_KEY=CHANGEME
# Le 1er hôte sert au healthcheck intégré à l'image ; messages-backend pour messages-mta-in.
DJANGO_ALLOWED_HOSTS=messages.localhost,messages-backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://messages.localhost:8000
INSTANCE_URL=http://messages.localhost:8000
PYTHONPATH=/app
GUNICORN_CMD_ARGS=--workers=2

LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

# Chiffrement des champs sensibles (clés DKIM…) : ne plus changer une fois des données créées.
SALT_KEY=CHANGEME

# --- Base de données (postgres partagé) -------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=messages
DB_USER=messages
DB_PASSWORD=CHANGEME

# --- Redis : cache + sessions (DB 4), broker Celery (DB 5) -----------------
REDIS_URL=redis://redis:6379/4
CELERY_BROKER_URL=redis://redis:6379/5

# --- OIDC (Keycloak partagé, realm startkit, client messages) ---------------
# Les conteneurs joignent auth.localhost:8000 via l'alias réseau du proxy.
OIDC_OP_JWKS_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=CHANGEME
OIDC_OP_USER_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=http://auth.localhost:8000/realms/startkit/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=messages
OIDC_RP_CLIENT_SECRET=CHANGEME
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES=openid email profile
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
OIDC_REDIRECT_ALLOWED_HOSTS=messages.localhost:8000
LOGIN_REDIRECT_URL=http://messages.localhost:8000
LOGIN_REDIRECT_URL_FAILURE=http://messages.localhost:8000
LOGOUT_REDIRECT_URL=http://messages.localhost:8000
# Comptes locaux créés uniquement pour les e-mails d'un domaine en oidc_autojoin
# (startkit.localhost). Mettre True pour accepter n'importe quel compte Keycloak.
OIDC_CREATE_USER=False
# Pas d'IDENTITY_PROVIDER : l'autojoin n'en a pas besoin (pas de identity_sync).

# --- Stockage S3 (MinIO partagé) --------------------------------------------
# Les URL présignées sont signées pour s3.localhost:8000 (joignable par le navigateur).
AWS_S3_ENDPOINT_URL=http://s3:9000
AWS_S3_DOMAIN_REPLACE=http://s3.localhost:8000
AWS_S3_ACCESS_KEY_ID=startkit
AWS_S3_SECRET_ACCESS_KEY=CHANGEME
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=messages-storage

# Imports (mbox/eml/pst) : bucket créé par messages-migrate (expiration 7 jours).
STORAGE_MESSAGE_IMPORTS_ENDPOINT_URL=http://s3:9000
STORAGE_MESSAGE_IMPORTS_BUCKET_NAME=messages-imports
STORAGE_MESSAGE_IMPORTS_ACCESS_KEY=startkit
STORAGE_MESSAGE_IMPORTS_SECRET_KEY=CHANGEME
STORAGE_MESSAGE_IMPORTS_REGION_NAME=us-east-1
STORAGE_MESSAGE_IMPORTS_EXPIRE_POLICY=3600

# Stockage étagé des blobs : bucket créé par messages-migrate, déport désactivé
# (MESSAGES_BLOBS_OFFLOAD_ENABLED=False par défaut : les blobs restent en base).
STORAGE_MESSAGE_BLOBS_ENDPOINT_URL=http://s3:9000
STORAGE_MESSAGE_BLOBS_BUCKET_NAME=messages-blobs
STORAGE_MESSAGE_BLOBS_ACCESS_KEY=startkit
STORAGE_MESSAGE_BLOBS_SECRET_KEY=CHANGEME
STORAGE_MESSAGE_BLOBS_REGION_NAME=us-east-1

# --- OpenSearch -----------------------------------------------------------
# Mettre False (et retirer messages-opensearch) pour se passer de la recherche.
OPENSEARCH_URL=http://messages-opensearch:9200
OPENSEARCH_INDEX_THREADS=True

# --- Courriel sortant : tout part vers mailpit -----------------------------
MTA_OUT_MODE=relay
MTA_OUT_RELAY_HOST=mail:1025
MTA_OUT_SMTP_TLS_SECURITY_LEVEL=none
MESSAGES_TECHNICAL_DOMAIN=startkit.localhost
# Messages entre boîtes de l'instance livrés en interne (n'apparaissent pas dans mailpit).
MESSAGES_ALLOW_INTERNAL_DELIVERY=True
# Pas d'anti-spam (rspamd/mpa non lancé).
SPAM_CONFIG={}

# --- Courriel entrant : backend (MDA) <-> messages-mta-in -------------------
# Secret partagé : signe les JWT envoyés par le MTA au backend. Lu par les deux.
MDA_API_SECRET=CHANGEME
MESSAGES_SELFCHECK_SECRET=CHANGEME

# Lus seulement par messages-mta-in (pymta).
MDA_API_BASE_URL=http://messages-backend:8000/api/v1.0/
PYMTA_SMTP_HOSTNAME=mx.startkit.localhost
PYMTA_SMTP_BIND_PORT=25
PYMTA_LOG_LEVEL=INFO

# --- Fonctionnalités --------------------------------------------------------
FEATURE_AI_SUMMARY=False
FEATURE_AI_AUTOLABELS=False
ENABLE_PROMETHEUS=False
