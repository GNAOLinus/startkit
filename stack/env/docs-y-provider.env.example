# Exemple de configuration : copier ce fichier en .env puis remplacer les CHANGEME.
# La Suite Docs — service de conversion y-provider (docs-y-provider).
# D'après env.d/production.dist/yprovider du dépôt docs (v6.0.4). Il ne sert plus
# la collaboration (c'est docs-yhub) : seulement les conversions appelées par le
# backend sur Y_PROVIDER_API_BASE_URL. Rien ne lui est routé par le proxy.

PORT=4444
# Même valeur que dans docs.env et docs-yhub.env.
Y_PROVIDER_API_KEY=CHANGEME
COLLABORATION_SERVER_ORIGIN=http://docs.localhost:8000
# Backend dont il lit le JWKS pour vérifier les jetons des appels qu'il reçoit.
COLLABORATION_BACKEND_BASE_URL=http://docs-backend:8000
COLLABORATION_LOGGING=true
# Tas Node limité (l'image fixe 2048 Mo).
NODE_OPTIONS=--max-old-space-size=512
