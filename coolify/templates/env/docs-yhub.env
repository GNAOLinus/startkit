# La Suite Docs — serveur de collaboration yhub (docs-yhub, docs-yhub-init).
# D'après env.d/production.dist/yhub du dépôt docs (v6.0.4). Ce service ne lit
# aucune variable du backend : tout ce qu'il utilise est ici.

PORT=3002
# Rôle "all" (défaut) : serveur websocket et worker de persistance dans un seul
# process. Concurrence du worker réduite (défaut 5) pour la RAM.
YHUB_ROLE=all
YHUB_TASK_CONCURRENCY=2
NODE_OPTIONS=--max-old-space-size=512

## Stores
# Redis partagé, base 1, préfixe docs-yhub (le backend Docs est en base 0).
# L'exemple officiel donne à yhub un Valkey à part (AOF, volatile-lru) car ce
# Redis contient les mises à jour pas encore persistées dans postgres (fenêtre
# de ~10 s, YHUB_TASK_DEBOUNCE_MS). Ici le redis partagé est en noeviction
# (aucune clé évincée) : seul un arrêt brutal de redis peut perdre ces quelques
# secondes, acceptable en local.
REDIS=redis://redis:6379/1
REDIS_PREFIX=docs-yhub
# Base "yhub" du postgres partagé. Schéma créé par docs-yhub-init (yarn init-db).
POSTGRES=postgres://yhub:${DB_PASSWORD_YHUB}@postgres:5432/yhub

## Backend Docs
# Joint en direct (comme l'environnement de dev du dépôt) : qui est l'utilisateur
# (cookie docs_sessionid relayé), quels droits sur le document, et JWKS du backend.
COLLABORATION_BACKEND_BASE_URL=http://docs-backend:8000
# Origines autorisées à ouvrir le websocket (origine nue, sans slash final).
COLLABORATION_SERVER_ORIGIN=https://docs.${DOMAIN}
# Même valeur que dans docs.env (Y_PROVIDER_API_KEY) : envoyée en X-Y-Provider-Key.
Y_PROVIDER_API_KEY=${AI_PROVIDER_API_KEY}
# Signe les appels au backend ; clé à part de celle du backend, générée par docs-keys.
YHUB_JWT_PRIVATE_KEY_FILE=/keys/yhub-private.pem

## Stockage des documents dans S3 (bucket versionné docs-yhub-storage, créé par s3-init)
# Comme le déploiement helm de dev : les blobs compactés vont dans le bucket,
# postgres garde l'index. Ne jamais retirer les YHUB_S3_* une fois des documents
# écrits (ils deviendraient vides) : pour revenir à postgres seul, mettre
# YHUB_S3_PERSISTENCE=false et garder le reste.
YHUB_S3_PERSISTENCE=true
YHUB_S3_ENDPOINT_URL=http://s3:9000
YHUB_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}
YHUB_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
YHUB_S3_BUCKET_NAME=docs-yhub-storage
YHUB_S3_REGION_NAME=us-east-1

# Pas de migration douce : instance neuve, aucun document à reprendre du bucket média.
#SOFT_MIGRATION=true
