# La Suite Drive (« Fichiers ») — backend Django (drive-backend, drive-celery, drive-migrate).
# D'après env.d/development/common, docs/env.md et docs/examples/helm/drive.values.yaml
# du dépôt drive (v0.26.0).
# Adresse publique : https://fichiers.${DOMAIN} (même URL depuis les conteneurs,
# via le proxy public, à l'intérieur comme à l'extérieur).
# Secrets de développement uniquement : ne pas réutiliser ailleurs.

## Django
# Classe "Http" (config drive-settings-http dans stack/apps/drive.yml) : Production
# sans redirection HTTPS, sans HSTS ni cookies Secure, que Production force en dur.
DJANGO_SETTINGS_MODULE=drive.settings_http
DJANGO_CONFIGURATION=Http
DJANGO_SECRET_KEY=${SECRET_KEY_DRIVE}
# drive-backend : appels directs sur le réseau compose ; localhost : sonde.
DJANGO_ALLOWED_HOSTS=fichiers.${DOMAIN},drive-backend,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://fichiers.${DOMAIN}
DJANGO_CORS_ALLOWED_ORIGINS=https://fichiers.${DOMAIN}
PYTHONPATH=/app

# Super-utilisateur Django (/admin), créé par drive-migrate.
DJANGO_SUPERUSER_EMAIL=admin@startkit.${DOMAIN}
DJANGO_SUPERUSER_PASSWORD=${DJANGO_ADMIN_PASSWORD}

## Logging
LOGGING_LEVEL_HANDLERS_CONSOLE=INFO
LOGGING_LEVEL_LOGGERS_ROOT=INFO
LOGGING_LEVEL_LOGGERS_APP=INFO

## Base de données (postgres partagé, base "drive")
DB_HOST=postgres
DB_PORT=5432
DB_NAME=drive
DB_USER=drive
DB_PASSWORD=${DB_PASSWORD_DRIVE}

## Redis partagé : base 6 pour le cache et les sessions, base 7 pour la file Celery.
REDIS_URL=redis://redis:6379/6
DJANGO_CELERY_BROKER_URL=redis://redis:6379/7

## E-mails (mailpit : https://mail.${DOMAIN})
DJANGO_EMAIL_HOST=mail
DJANGO_EMAIL_PORT=1025
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_FROM=fichiers@startkit.${DOMAIN}
DJANGO_EMAIL_BRAND_NAME="La Suite Numérique"
DJANGO_EMAIL_LOGO_IMG=https://fichiers.${DOMAIN}/assets/logo-suite-numerique.png
DJANGO_EMAIL_URL_APP=https://fichiers.${DOMAIN}

## Fichiers (S3 partagé, bucket drive-media-storage versionné, créé par s3-init)
# Le backend lit et écrit sur s3:9000. Les envois partent du navigateur, en PUT
# direct sur une URL présignée : la signature porte sur l'hôte, d'où
# AWS_S3_DOMAIN_REPLACE (hôte que le navigateur joint, via Caddy qui conserve l'en-tête
# Host). Les lectures passent par /media/ (auth_request de drive-frontend), signées
# pour s3:9000.
AWS_S3_ENDPOINT_URL=http://s3:9000
AWS_S3_DOMAIN_REPLACE=https://s3.${DOMAIN}
AWS_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_S3_SECRET_ACCESS_KEY=${S3_SECRET_KEY}
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_STORAGE_BUCKET_NAME=drive-media-storage
MEDIA_BASE_URL=https://fichiers.${DOMAIN}

## OIDC (Keycloak partagé, realm "startkit", client "drive")
OIDC_OP_JWKS_ENDPOINT=https://auth.${DOMAIN}/realms/startkit/protocol/openid-connect/certs
OIDC_OP_AUTHORIZATION_ENDPOINT=https://auth.${DOMAIN}/realms/startkit/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=https://auth.${DOMAIN}/realms/startkit/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=https://auth.${DOMAIN}/realms/startkit/protocol/openid-connect/userinfo
OIDC_OP_LOGOUT_ENDPOINT=https://auth.${DOMAIN}/realms/startkit/protocol/openid-connect/logout
OIDC_RP_CLIENT_ID=drive
OIDC_RP_CLIENT_SECRET=${CLIENT_SECRET_DRIVE}
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"
# Claims standard de Keycloak (les valeurs par défaut first_name/last_name n'y sont pas).
OIDC_USERINFO_FULLNAME_FIELDS=given_name,family_name
OIDC_USERINFO_SHORTNAME_FIELD=given_name
OIDC_REDIRECT_ALLOWED_HOSTS=fichiers.${DOMAIN}
OIDC_REDIRECT_REQUIRE_HTTPS=false

LOGIN_REDIRECT_URL=https://fichiers.${DOMAIN}
LOGIN_REDIRECT_URL_FAILURE=https://fichiers.${DOMAIN}
LOGOUT_REDIRECT_URL=https://fichiers.${DOMAIN}

# Connexion silencieuse (prompt=none) : déjà connecté à Keycloak via une autre
# app de la suite => connecté à Fichiers sans clic.
FRONTEND_SILENT_LOGIN_ENABLED=true

## Fonctions désactivées
# Recherche indexée (Find) : aucun indexeur (SEARCH_INDEXER_CLASS vide par défaut).
FEATURES_INDEXED_SEARCH=false
# Antivirus : backend factice de django-lasuite, tout fichier est déclaré sain
# immédiatement (valeur par défaut, explicitée ici).
MALWARE_DETECTION_BACKEND=lasuite.malware_detection.backends.dummy.DummyBackend
# Édition bureautique en ligne (WOPI : Collabora / OnlyOffice) : désactivée tant que
# WOPI_CLIENTS est absent (liste vide). Voir l'en-tête de stack/apps/drive.yml.
# WOPI_CLIENTS=collabora
# WOPI_COLLABORA_DISCOVERY_URL=http://drive-collabora:9980/hosting/discovery
# WOPI_SRC_BASE_URL=http://drive-backend:8000
# Analytics : désactivées (POSTHOG_KEY absent), pas de Sentry.
