# La Suite Projets — variables d'environnement (voir ENVIRONMENT_VARIABLES.md du dépôt)

## Requis
BASE_URL=https://projects.${DOMAIN}
DATABASE_URL=postgresql://projects:${DB_PASSWORD_PROJECTS}@postgres:5432/projects
# Signe les cookies de session (valeur de dev uniquement).
SECRET_KEY=${SECRET_KEY_PROJECTS}

## Derrière Caddy, en HTTP simple
# Le serveur lit `!!process.env.TRUST_PROXY` : "0" serait vrai aussi, d'où "true".
# Cookies : pas de `secure` côté serveur, et le client ne met `secure` qu'en https.
TRUST_PROXY=true
TZ=UTC

## OpenID Connect (Keycloak partagé, realm startkit)
# Même URL dans le navigateur et dans le conteneur (URL publique).
OIDC_ISSUER=https://auth.${DOMAIN}/realms/startkit
OIDC_CLIENT_ID=projects
OIDC_CLIENT_SECRET=${CLIENT_SECRET_PROJECTS}
OIDC_ENFORCED=true
OIDC_SCOPES=openid email profile
OIDC_USE_DEFAULT_RESPONSE_MODE=true
OIDC_CLAIMS_SOURCE=userinfo
OIDC_EMAIL_ATTRIBUTE=email
OIDC_FULLNAME_ATTRIBUTES=given_name,family_name
OIDC_IGNORE_USERNAME=true
OIDC_IGNORE_ROLES=true
# Redirection : BASE_URL/oidc-callback ; après déconnexion : BASE_URL.

## Fonctionnel
ALLOW_ALL_TO_CREATE_PROJECTS=true
# Mode libre : ORGANIZATION_ID_CLAIM (ex. siret) non défini, le realm n'a pas ce claim.
DEFAULT_LANGUAGE=fr-FR
DISABLE_INDEXING=true

## Admin par défaut (seedé à chaque démarrage par db/init.js)
# Pas de mot de passe : connexion uniquement via OIDC. Quand user1 se connecte
# par Keycloak, son compte est rattaché par e-mail à cet admin, et
# OIDC_IGNORE_ROLES=true conserve isAdmin.
DEFAULT_ADMIN_EMAIL=user1@startkit.${DOMAIN}
DEFAULT_ADMIN_NAME=Camille Martin

## E-mails -> Mailpit (https://mail.${DOMAIN})
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM='"Projets" <projets@startkit.${DOMAIN}>'
