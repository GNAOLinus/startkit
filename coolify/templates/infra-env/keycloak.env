# Gabarit de coolify/generated/keycloak.env (ne pas éditer : généré par prepare.sh).
#
# Clés exposées à Coolify sous le préfixe KEYCLOAK_ (voir coolify/compose.flat.yml).
KC_DB_PASSWORD=${DB_PASSWORD_KEYCLOAK}
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
KC_HOSTNAME=https://auth.${DOMAIN}
